# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# External repositories cloned locally (not part of this project's history)
dataset/
eurovision-api/

# Generated output: everything is regenerated by scripts/build_graph.py and
# scripts/style_gexf.py. Only the Gephi project is versioned, because rebuilding
# it needs Gephi + a JDK (scripts/gephi/make_project.sh).
output/*
!output/gephi/
# Report network figures (scripts/gephi/render_report.sh): only the two final
# figures included by RELAZIONE.TEX are versioned; flags and intermediates are
# regenerated.
output/gephi/flags/
output/gephi/report/*
!output/gephi/report/fig_*.png

# LaTeX build of RELAZIONE.TEX (latexmk -outdir=build)
build/

# Student ID numbers and the submission PDF stay local (public repository)
matricole.tex
RELAZIONE-consegna.pdf
Botrugno and Fabrizio and Musa and Samoggia.pdf

# Italian translation of the report, kept locally only
RELAZIONE_IT.tex
RELAZIONE_IT.pdf

# Internal planning documents, kept locally only (public repository)
docs/L_Eurovision Song Contest (ESC).docx
docs/Piano_Guida_Progetto_Network_Analysis.docx
docs/Eurovision_Research_Questions_SNA.pdf
