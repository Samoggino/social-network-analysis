# Python env locale del progetto (uv), mai il Python di sistema.
# Versioni di riferimento di RQ2/requirements.txt + scipy per RQ3.
if [ ! -x .venv/bin/python ]; then
  uv venv -q -p 3.13 .venv
  VIRTUAL_ENV="$PWD/.venv" uv pip install -q numpy==2.4.2 networkx==3.6.1 matplotlib==3.10.8 scipy
fi
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin
